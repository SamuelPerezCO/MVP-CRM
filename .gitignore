# Agent skills (installed via `npx skills add`)
.agents/
.claude/skills/
.claude/settings.local.json
skills-lock.json

# Python virtualenv
venv/

# Python
__pycache__/
*.py[cod]

# Django
db.sqlite3
/staticfiles/
/media/

# Local environment / credentials (.env.example documents the variables).
# The glob matters: an editor's .env.bak or .env.local holds the same live
# DATABASE_URL, and this repository is public.
.env
.env.*
!.env.example

# Intermediate files assemble.py writes next to the PDF it renders.
docs/generar/*.final.json

# Stale git lock files that tooling parks here when it recovers from an
# interrupted operation (index.lock.stale, locks/.git_HEAD.lock.<pid>). They
# are always empty and always disposable; ignored so a re-run does not commit
# them back into the tree.
/_to_delete/
