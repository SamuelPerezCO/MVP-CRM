# Copy to .env before running `npm start` (this file is gitignored).

# Shared secret between this sidecar and Django. Must match Django's
# BAILEYS_SIDECAR_SECRET env var exactly. Used both ways: Django checks it on
# webhook POSTs from here, and /send checks it on calls from Django.
SIDECAR_SECRET=dev-sidecar-secret

# Full URL of Django's baileys webhook endpoint.
# Local dev: http://localhost:8000/webhooks/messaging/baileys/
DJANGO_WEBHOOK_URL=http://localhost:8000/webhooks/messaging/baileys/

# Port this sidecar's HTTP server listens on. Must match Django's
# BAILEYS_SIDECAR_URL (e.g. http://localhost:4000).
PORT=4000

# Where WhatsApp auth/session state is persisted between restarts so you
# don't have to re-scan the QR code every time. Leave as-is unless you need
# to run more than one sidecar instance.
AUTH_DIR=./auth
